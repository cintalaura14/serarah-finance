# ================================================
# SERARAH FINANCE AI - Konfigurasi Gemini API (Google)
# ================================================
# Dapatkan API key di https://aistudio.google.com/app/apikey
# JANGAN commit file .env ini ke repository. Salin menjadi .env dan isi nilainya.

# API key Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Nama model Gemini yang dipakai (opsional)
GEMINI_MODEL=gemini-2.0-flash

# Port untuk server proxy SERARAH ini
PORT=3000

# ================================================
# Konfigurasi OpenRouter (fallback AI ketika Gemini habis kuota)
# ================================================
# Dapatkan API key di https://openrouter.ai/keys
# OpenRouter dipakai otomatis sebagai pengganti Gemini saat kuota Gemini habis (429).

# API key OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Nama model OpenRouter (harus model yang mendukung input gambar/vision)
# Cek daftar model di https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini
